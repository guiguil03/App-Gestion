DATABASE_URL="postgresql://postgres:postgres@localhost:5432/presence_scolaire?schema=public"
JWT_SECRET="dev-secret-change-me"
PORT=3000

# Stockage des fichiers (photos élève, logos école) — bucket Railway (ou tout
# stockage S3-compatible). Voir src/common/storage/s3-storage.service.ts.
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"

# Origine publique du backend, utilisée pour construire les URLs /media/...
# renvoyées au client (voir src/common/storage/media-url.ts). Sur Railway,
# RAILWAY_PUBLIC_DOMAIN est injectée automatiquement et sert de fallback —
# cette variable n'est nécessaire qu'en dev local ou avec un domaine custom.
PUBLIC_BACKEND_URL="http://localhost:3000"

# Origines autorisées à appeler l'API depuis un navigateur (liste séparée par
# des virgules). Sans effet sur le dashboard (proxy serveur-à-serveur) ni le
# mobile (client natif) — voir src/common/config/cors.config.ts. Par défaut
# (variable absente) : ports de dev locaux uniquement.
CORS_ALLOWED_ORIGINS=""

# Clé de chiffrement (AES-256-GCM) des données personnelles sensibles
# (téléphone, adresse des parents/tuteurs — voir src/common/crypto/field-encryption.ts).
# Générer avec : openssl rand -base64 32 (ou node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Requise pour démarrer l'app — ne JAMAIS la faire tourner sans backup sécurisé
# de cette valeur : sans elle, les numéros/adresses déjà chiffrés en base sont
# irrécupérables.
FIELD_ENCRYPTION_KEY=""

# Passerelle SMS (Twilio) — laisser vide en dev : MockSmsProvider prend le
# relais automatiquement (logue le SMS au lieu de l'envoyer). Renseigner les
# 3 variables pour activer l'envoi réel (voir apps/backend/src/modules/notifications).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Monitoring d'erreurs (Sentry) — laisser vide pour désactiver (aucun envoi).
# Créer un projet Node sur sentry.io puis coller son DSN ici.
SENTRY_DSN=""
